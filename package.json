{
  "name": "dsh-memgate",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "记忆门插件：检索先行、记忆三域、写入回仓写成常驻系统提示；附原生全文检索（rg 直调）与检索面盘点工具，不依赖已死的旧检索脚本。",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}